# ---------------------------------------------------------------- base de donnees
POSTGRES_USER=ananas
POSTGRES_PASSWORD=ananas
POSTGRES_DB=ananas
# Utilise par le backend et le worker (hote `db` = nom du service docker)
DATABASE_URL=postgresql+psycopg://ananas:ananas@db:5432/ananas
# Ports exposes sur l'hote (a changer en cas de conflit avec un autre projet)
POSTGRES_PORT=5434
BACKEND_PORT=8000
WEB_PORT=5173

# ---------------------------------------------------------------- securite
# openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRE_DAYS=30
# NAS derriere HTTPS : cookie de session en Secure (defaut true en prod).
# Laisse vide / false en dev sur http://localhost.
COOKIE_SECURE=false
# Origines autorisees a envoyer le cookie de session (separees par des virgules)
# - dev   : http://localhost:5173
# - NAS   : l'URL publique du FRONT servie par Nginx Proxy Manager,
#           ex. https://ananas.mondomaine.fr
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- notifications
# Token du bot unique, obtenu aupres de @BotFather. Chaque utilisateur ne
# renseigne que son chat_id dans /settings.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- modele de langage
# Sert uniquement a structurer du texte libre (offres, CV). La comparaison
# profil/offre est du Python deterministe.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=

# ---------------------------------------------------------------- worker
TZ=Europe/Brussels
# Scrape + soumission du lot d'extraction Gemini (voir api/README.md, section
# "Extraction des offres, en direct ou par lot"). Minuit laisse toute la nuit
# au lot pour se terminer avant la notification.
SCRAPE_CRON_HOUR=0
SCRAPE_CRON_MINUTE=0
# Recolte du lot (partielle si besoin) + notification quotidienne.
NOTIFY_CRON_HOUR=7
NOTIFY_CRON_MINUTE=0

# ---------------------------------------------------------------- front
# URL de l'API vue depuis le NAVIGATEUR (pas depuis le reseau docker : le
# front est un SPA, le fetch part du navigateur, `http://backend:8000` n'y
# resout pas).
# - dev : http://localhost:8000
# - NAS : l'URL publique de l'API, exposee par Nginx Proxy Manager via un
#         proxy host distinct pointant sur `backend:8000`,
#         ex. https://api.ananas.mondomaine.fr
PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- deploiement NAS
# Nom du reseau docker partage avec Nginx Proxy Manager (docker-compose.prod.yml).
#   docker network create proxy
PROXY_NETWORK=proxy

# --- Compte d'administration
# Lu par `python -m ananas.admin`, qui cree ou met a jour ce compte.
# L'API ne lit jamais ces variables: aucune route ne promeut un compte.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
